# Postgres connection string (from Render/Neon/Railway/etc)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Long random string used to sign login tokens - generate your own
JWT_SECRET="change-this-to-a-long-random-string"

# Free Groq API key - sign up at https://console.groq.com (no credit card needed)
GROQ_API_KEY="gsk_..."

# Optional: override which free Groq model to use.
# Check https://console.groq.com/docs/models for the current free lineup
# if this default ever stops working.
GROQ_MODEL="openai/gpt-oss-120b"

# Port the server listens on (Render sets this automatically in production)
PORT=3000
